// SampCode relational model. The survey questionnaire itself is a versioned JSON document
// (SurveyVersion.definition) validated by @zapx/survey-schema; everything that is queried
// operationally (responses, quotas, vendors, audit) lives in tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROGRAMMER
  VIEWER
  /// Field interviewer: can only use the CAPI app for surveys assigned to them.
  INTERVIEWER
}

/// How an interview was conducted.
enum InterviewMode {
  /// Self-completed online (the hosted runtime).
  CAWI
  /// Face to face with an interviewer, in the offline CAPI app.
  CAPI
  /// By telephone, an interviewer working a call list (Milestone 9).
  CATI
}

enum CatiCaseStatus {
  /// Waiting to be called (first call, or a retry after no answer or busy).
  PENDING
  /// A callback was agreed for a time.
  CALLBACK
  /// An interviewer has the case open now.
  IN_CALL
  /// The interview finished (any outcome: complete, terminate, quota full...).
  DONE
  /// No more calls: refused, wrong number, not eligible, or out of attempts.
  CLOSED
}

/// Human quality review of a complete (Milestone 5).
enum ReviewState {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}

/// Which projects a member can see (Milestone 6). Admins always see every project.
enum ProjectScope {
  /// Every project in the organization.
  ALL
  /// Only projects the member was added to (ProjectMember).
  ASSIGNED
}

enum SurveyStatus {
  DRAFT
  LIVE
  PAUSED
  CLOSED
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum RedirectMode {
  STATIC
  DYNAMIC
  HYBRID
}

enum ChangeSource {
  AI
  IMPORT
  MANUAL
}

enum ChangeStatus {
  PROPOSED
  APPLIED
  REJECTED
}

enum ResponseStatus {
  IN_PROGRESS
  COMPLETE
  TERMINATE
  QUOTA_FULL
  QUALITY_FAIL
  SECURITY_REJECT
  DUPLICATE
  PARTIAL
  TECHNICAL_ERROR
}

/// How SampCode exchanges outcomes with a sample source (see packages/redirect-core).
enum VendorIntegration {
  /// SampCode resolves redirects itself and sends optional signed callbacks.
  DIRECT
  /// SampCode is a client survey platform behind PROJEXA (PROJEXA docs/SURVEY_INTEGRATION.md).
  PROJEXA
  /// SampCode is the survey host behind SAMPLEON, the Sampledge audience and routing engine. Same
  /// survey-host contract as PROJEXA (SAMPLEON docs/ECOSYSTEM_ARCHITECTURE.md §5.3).
  SAMPLEON
}

enum CallbackState {
  PENDING
  DELIVERED
  /// The receiver refused it permanently (4xx other than 408/429), or reported a conflict.
  FAILED
  /// Every attempt failed transiently; kept for manual replay.
  DEAD
}

model Tenant {
  id                      String          @id @default(cuid())
  name                    String
  /// Organization-level redirect defaults: {urls, words, countries} (lowest precedence).
  redirectDefaults        Json            @default("{}")
  /// Plan code (Milestone 8): free, team, business or enterprise. Limits live in code (plans.ts).
  plan                    String          @default("enterprise")
  /// Billing (Milestone 13): the Stripe customer and subscription behind the plan, when billing is on.
  billingCustomerId       String?         @unique
  billingSubscriptionId   String?
  /// Stripe subscription status (active, trialing, past_due, canceled, ...).
  billingStatus           String?
  billingPeriodEnd        DateTime?
  /// Quantum Design System: the organization's default appearance for members who have not chosen their own.
  appearanceDefaults      Json            @default("{}")
  /// Blueprint phase 5: saved workspace presets, [{id, name, appearance, modules}], shared with members.
  appearancePresets       Json            @default("[]")
  /// Blueprint phase 5: the region the organization's data must stay in (e.g. "eu"), checked
  /// against the deployment's DATA_REGION; null when the organization has not set one.
  dataRegion              String?
  /// Blueprint phase 5: when on, features that send data to a processor outside the deployment
  /// (AI, transcription) are refused for this organization.
  blockExternalProcessors Boolean         @default(false)
  /// Blueprint phase 5: retention policy {responsesDays?, capturesDays?, contactsDays?} (null: keep).
  retention               Json            @default("{}")
  /// The organization that runs this installation (Integrations in the CRM). Its administrators set
  /// the platform-wide integrations: AI, IPinfo, Deepgram, Twilio, Stripe and file storage.
  platformOperator        Boolean         @default(false)
  /// Super admin: subscription state (active, trialing, expired, cancelled) and when it ends (null: no end).
  subscriptionStatus      String          @default("active")
  subscriptionEndsAt      DateTime?
  /// Super admin: a suspended organization cannot sign in or use any feature until reactivated.
  suspendedAt             DateTime?
  suspendedReason         String?
  /// Super admin: per-organization feature changes on top of the plan, {web: {key: bool}, mobile: {key: bool}}.
  featureOverrides        Json            @default("{}")
  /// Super admin: private notes about the organization (contract, contact, ...).
  adminNotes              String          @default("")
  createdAt               DateTime        @default(now())
  users                   User[]
  projects                Project[]
  aiPolicy                TenantAiPolicy?
  sso                     TenantSso?
  scim                    TenantScim?
}

/// Single sign-on for one organization: OpenID Connect (Milestone 8) or SAML 2.0 (Milestone 13).
model TenantSso {
  tenantId           String   @id
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  enabled            Boolean  @default(false)
  /// OIDC or SAML. The OIDC fields are empty for SAML and the SAML fields null for OIDC.
  protocol           String   @default("OIDC")
  /// SAML: the identity provider's single sign-on URL (HTTP-Redirect binding).
  samlEntryPoint     String?
  /// SAML: the identity provider's entity ID (the Issuer of its responses).
  samlIdpIssuer      String?
  /// SAML: the identity provider's signing certificates (PEM, public). Several during a rotation.
  samlCerts          String[] @default([])
  issuer             String
  clientId           String
  /// Client secret sealed with SecretBox.
  clientSecretSealed String
  /// Email domains that sign in through this organization's identity provider (lower case).
  domains            String[]
  /// When true, members other than admins cannot sign in with a password.
  enforced           Boolean  @default(false)
  /// Create a member on first sign-in (just-in-time provisioning) with this role. Null = only existing members.
  jitRole            Role?
  updatedById        String?
  updatedAt          DateTime @updatedAt
}

/// A SAML sign-in in progress (Milestone 13): the AuthnRequest ID, used once to check InResponseTo.
model SsoRequest {
  id        String   @id
  tenantId  String
  next      String   @default("/")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Stripe webhook events already applied (Milestone 13), so a redelivered event changes nothing.
model BillingEvent {
  id        String   @id
  type      String
  tenantId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// SCIM 2.0 provisioning token for one organization (Milestone 8). Stored hashed like API keys.
model TenantScim {
  tenantId    String    @id
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  prefix      String    @unique
  secretHash  String
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
}

model User {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  email             String           @unique
  name              String
  passwordHash      String
  role              Role             @default(PROGRAMMER)
  projectScope      ProjectScope     @default(ALL)
  /// Disabled members cannot sign in, and their sessions and API keys stop working at once.
  disabledAt        DateTime?
  /// Personal preferences, e.g. {appearance: {...}} (Quantum Design System). Follows the member across devices.
  preferences       Json             @default("{}")
  /// Subject from the organization's identity provider (OIDC `sub`), set on first SSO sign-in.
  ssoSubject        String?
  /// The identity provider's id for this member when provisioned through SCIM.
  scimExternalId    String?
  createdAt         DateTime         @default(now())
  capiAssignments   CapiAssignment[]
  capiInterviews    Response[]       @relation("CapiInterviewer")
  projects          ProjectMember[]
  apiKeys           ApiKey[]
  /// Milestone 19: the phone the dialer rings for this interviewer (sealed), and its last digits.
  phoneSealed       String?
  phoneHint         String?
  /// Milestone 20: failed password sign-ins in a row, and when the account may try again.
  failedLogins      Int              @default(0)
  lockedUntil       DateTime?
  /// Milestone 20: sessions issued before this moment no longer work ("sign out everywhere").
  sessionsRevokedAt DateTime?
  /// Super admin of the whole installation: registers organizations, manages plans, features and integrations.
  superAdmin        Boolean          @default(false)
  /// Super admin: features removed from this one member, {web: {key: false}, mobile: {key: false}}.
  featureOverrides  Json             @default("{}")
  /// Super admin: whether this member may use the mobile app at all.
  mobileAccess      Boolean          @default(true)
  /// Last request seen from this member (written at most once a minute) and from which client (web or mobile).
  lastSeenAt        DateTime?
  lastClient        String?

  @@unique([tenantId, ssoSubject])
  @@index([tenantId])
}

model Project {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  name             String
  client           String?
  /// Project-level redirect defaults: {urls, words, countries}. Vendors override these.
  redirectDefaults Json            @default("{}")
  createdAt        DateTime        @default(now())
  /// Soft delete: hidden everywhere, kept for audit and data retention.
  deletedAt        DateTime?
  surveys          Survey[]
  vendors          Vendor[]
  members          ProjectMember[]

  @@index([tenantId, deletedAt])
}

/// A member with ASSIGNED project scope can see and work on this project (Milestone 6).
model ProjectMember {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tenantId  String
  addedById String?
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Survey {
  id              String           @id @default(cuid())
  tenantId        String
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id])
  name            String
  status          SurveyStatus     @default(DRAFT)
  /// The published version respondents currently receive.
  liveVersionId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// Soft delete: hidden everywhere, kept for audit and data retention.
  deletedAt       DateTime?
  versions        SurveyVersion[]
  responses       Response[]
  quotaCounts     QuotaCount[]
  qaRuns          QaRun[]
  changeSets      ChangeSet[]
  capiAssignments CapiAssignment[]
  catiCases       CatiCase[]
  reports         Report[]
  MediaAsset      MediaAsset[]

  @@index([tenantId, projectId, deletedAt])
}

model SurveyVersion {
  id           String        @id @default(cuid())
  surveyId     String
  survey       Survey        @relation(fields: [surveyId], references: [id])
  version      Int
  /// Canonical survey definition (see @zapx/survey-schema). Immutable once published.
  definition   Json
  status       VersionStatus @default(DRAFT)
  /// Presentation layer: theme, translations and device settings (see presentationSchema).
  /// Versioned with the definition, so a published version always looks the same.
  presentation Json          @default("{}")
  /// Static logic analysis report captured at publish time.
  checkReport  Json?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publishedAt  DateTime?
  responses    Response[]

  @@unique([surveyId, version])
}

model Vendor {
  id                  String             @id @default(cuid())
  tenantId            String
  projectId           String
  project             Project            @relation(fields: [projectId], references: [id])
  name                String
  /// Vendor ID passed on survey links (vid=...). Unique within a project.
  code                String
  integration         VendorIntegration  @default(DIRECT)
  redirectMode        RedirectMode       @default(STATIC)
  /// Static redirect URL per outcome status, e.g. {"complete": "https://...?uid=[UID]"}.
  staticUrls          Json               @default("{}")
  /// Words sent for [STATUS] per outcome, e.g. {"quota_full": "overquota"}.
  statusWords         Json               @default("{}")
  /// Hosts allowed for dynamic return URLs supplied at entry (protects against open redirects).
  dynamicAllowedHosts String[]           @default([])
  /// Query parameter that carries the dynamic return URL on entry.
  dynamicParam        String             @default("rurl")
  /// Shared secret for signed entry links and signed redirects.
  secret              String
  requireSignedEntry  Boolean            @default(false)
  signRedirects       Boolean            @default(false)
  /// Per-country overrides: {"DE": {"urls": {...}, "words": {...}}}. Highest precedence.
  countryRedirects    Json               @default("{}")
  /// Callback (postback) URL template, sent as a signed GET when an outcome is recorded.
  callbackUrl         String?
  /// Outcome statuses that trigger a callback.
  callbackStatuses    String[]           @default([])
  /// Delivery attempts per callback before it is dead-lettered (1-10).
  callbackMaxAttempts Int                @default(6)
  /// PROJEXA integration: base URL, e.g. https://projexa.example.
  partnerBaseUrl      String?
  /// PROJEXA client secret for the S2S outcome signature, encrypted at rest (SecretBox).
  partnerSecretEnc    String?
  /// Send PROJEXA's S2S outcome confirmation.
  partnerS2s          Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  /// Soft delete. The code stays reserved so old links can never reach a different vendor.
  deletedAt           DateTime?
  responses           Response[]
  redirectEvents      RedirectEvent[]
  callbacks           OutboundCallback[]

  @@unique([projectId, code])
  @@index([tenantId, deletedAt])
}

model Response {
  id               String         @id @default(cuid())
  tenantId         String
  surveyId         String
  survey           Survey         @relation(fields: [surveyId], references: [id])
  /// The exact version this respondent answered.
  versionId        String
  version          SurveyVersion  @relation(fields: [versionId], references: [id])
  vendorId         String?
  vendor           Vendor?        @relation(fields: [vendorId], references: [id])
  uid              String
  country          String?
  isTest           Boolean        @default(false)
  status           ResponseStatus @default(IN_PROGRESS)
  /// Termination rule or quota that ended the interview, if any.
  outcomeReason    String?
  answers          Json           @default("{}")
  /// Seed of this respondent's page order when it differs from the response id (least-fill blocks).
  orderSeed        String?
  /// Index of the page currently shown; -1 once finished.
  currentPage      Int            @default(0)
  /// Extra entry parameters, available to redirects as [param:name].
  entryParams      Json           @default("{}")
  /// Validated dynamic return URL supplied at entry.
  returnUrl        String?
  /// SHA-256 of the respondent's session token; the token itself is never stored.
  sessionTokenHash String         @unique
  userAgent        String?
  /// Language the respondent answered in (BCP 47 tag).
  language         String?
  /// desktop, tablet or mobile, classified at entry.
  device           String?
  startedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  completedAt      DateTime?

  // ---- Milestone 5: mode, timing, quality and review ----
  mode          InterviewMode @default(CAWI)
  /// CAPI: the interviewer who conducted the interview.
  interviewerId String?
  interviewer   User?         @relation("CapiInterviewer", fields: [interviewerId], references: [id])
  /// CAPI: id generated on the device, so a retried upload is never stored twice.
  clientId      String?       @unique
  /// CAPI: device the interview was recorded on (generated by the app, not a hardware id).
  deviceId      String?
  syncedAt      DateTime?
  /// When the current page was shown (CAWI), for length-of-interview timing.
  pageShownAt   DateTime?
  /// Time spent on answered pages, in milliseconds (length of interview).
  durationMs    Int?
  /// Last page the respondent reached (drop-off reporting).
  lastPageId    String?
  /// Keyed HMAC of the network address, only for same-network checks; the address is never stored.
  ipHash        String?
  /// 0-100, set when a complete is scored. Null when quality scoring is off or not applicable.
  qualityScore  Int?
  /// [{code, ref?, penalty, detail}] from @zapx/quality-core.
  qualityFlags  Json          @default("[]")
  reviewState   ReviewState   @default(NONE)
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?

  // ---- Milestone 12: fraud signals and face-to-face capture ----
  /// Keyed HMAC of browser traits (screen, time zone, languages, platform, user agent). The traits are not stored.
  deviceHash   String?
  /// Browser signals while answering: {automation?, honeypot?, quietPages?, pasted?: [questionId]}.
  signals      Json      @default("{}")
  /// Two-letter country reported by the edge network (GEO_COUNTRY_HEADER), when configured.
  geoCountry   String?
  /// Milestone 16: what a network reputation service said about the respondent's address (vpn, proxy,
  /// tor, relay, hosting). Only these words are kept: not the address, not the provider's answer.
  networkFlags String[]  @default([])
  /// CAPI: {start?, end?: {lat, lon, accuracy, at}} and {audioConsent?}. Rounded to about a metre.
  location     Json?
  captures     Capture[]
  /// Blueprint phase 3, CAPI: {pageTimes: [{pageId, shownAt, ms}], interruptions: {count, totalMs, log}, geofence}.
  evidence     Json?
  /// Blueprint phase 4: the quotas this complete was counted toward (least-fill groups pick one), released on reject.
  quotaCells   String[]  @default([])
  /// Blueprint phase 5: when the retention policy erased this interview's answers and identifiers.
  /// The row stays (status, timings, counts), but analyses and exports leave it out.
  erasedAt     DateTime?

  @@unique([surveyId, vendorId, uid])
  @@index([surveyId, reviewState])
  @@index([surveyId, ipHash])
  @@index([surveyId, deviceHash])
  @@index([interviewerId, startedAt])
  @@index([tenantId, surveyId, status])
  @@index([vendorId, completedAt])
  /// Plan usage: completes per organization per month.
  @@index([tenantId, status, completedAt])
  @@index([status, updatedAt])
}

model QuotaCount {
  id             String @id @default(cuid())
  surveyId       String
  survey         Survey @relation(fields: [surveyId], references: [id])
  quotaId        String
  count          Int    @default(0)
  /// Target changed while the survey is live (no republish). Null: the published target applies.
  targetOverride Int?

  @@unique([surveyId, quotaId])
}

/// A platform-wide integration set up in the CRM (Settings > Integrations). When a row exists it
/// wins over the environment; a field left empty falls back to the environment variable.
model PlatformIntegration {
  /// anthropic, ipinfo, deepgram, twilio, stripe or s3
  key           String   @id
  enabled       Boolean  @default(false)
  /// Non-secret fields, e.g. {"model": "...", "callerId": "+44..."}.
  settings      Json     @default("{}")
  /// Secret fields as one JSON object sealed with SecretBox (SECRETS_KEY). Never sent back in full.
  secretsSealed String?
  updatedById   String?
  updatedAt     DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  data       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  /// Super admin: activity across every organization, newest first.
  @@index([createdAt])
}

/// A QA Laboratory run: synthetic respondents simulated against one survey version.
model QaRun {
  id          String   @id @default(cuid())
  tenantId    String
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id])
  versionId   String
  version     Int
  respondents Int
  seed        String
  passed      Boolean
  /// Coverage percent (0-100) of pages, questions, options, branches and outcomes.
  coverage    Float
  /// Full QaReport from @zapx/logic-engine simulateSurvey.
  report      Json
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, surveyId, createdAt])
}

/// A proposed edit to a survey draft (from AI, a file import or a manual paste). Nothing reaches
/// the draft until a programmer reviews and applies it.
model ChangeSet {
  id                 String       @id @default(cuid())
  tenantId           String
  surveyId           String
  survey             Survey       @relation(fields: [surveyId], references: [id])
  /// Draft version the proposal was made against, and its updatedAt at that moment.
  baseVersionId      String
  baseUpdatedAt      DateTime
  source             ChangeSource
  title              String
  /// The instruction or brief given (for AI), or the import file name.
  prompt             String?
  sourceFileName     String?
  /// Full proposed survey definition (validated by @zapx/survey-schema).
  proposedDefinition Json
  /// Structured diff against the base draft.
  diff               Json
  /// Assumptions and questions the author (AI or importer) wants a human to confirm.
  assumptions        Json         @default("[]")
  /// Import confidence and per-item issues, if any.
  confidence         Json?
  /// Schema and logic check of the proposed definition.
  check              Json
  status             ChangeStatus @default(PROPOSED)
  /// Model or importer that produced the proposal, e.g. "claude-opus-5-5" or "xlsx-template-v1".
  producer           String
  createdById        String?
  decidedById        String?
  decidedAt          DateTime?
  createdAt          DateTime     @default(now())

  @@index([tenantId, surveyId, createdAt])
}

/// Redirect audit log: every outcome redirect SampCode resolved, with the level that supplied it.
model RedirectEvent {
  id         String   @id @default(cuid())
  tenantId   String
  surveyId   String
  /// Null when the respondent was rejected before a response was recorded.
  responseId String?
  vendorId   String?
  vendor     Vendor?  @relation(fields: [vendorId], references: [id])
  uid        String
  status     String
  statusWord String
  /// static, dynamic, partner or none.
  source     String
  /// vendor_country, vendor, project_country, project or organization (static only).
  level      String?
  url        String?
  /// Why the outcome happened (termination id, quota id, rejection reason).
  reason     String?
  isTest     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([responseId, status])
  @@index([tenantId, vendorId, createdAt])
  @@index([tenantId, surveyId, createdAt])
}

/// Outbox of server-to-server callbacks. Written when an outcome is recorded and delivered by
/// the callback worker with retries; the idempotency key makes every outcome send at most one.
model OutboundCallback {
  id             String            @id @default(cuid())
  tenantId       String
  vendorId       String
  vendor         Vendor            @relation(fields: [vendorId], references: [id])
  responseId     String
  status         String
  /// "<responseId>:<status>" – unique, sent as X-Idempotency-Key on every attempt.
  idempotencyKey String            @unique
  integration    VendorIntegration
  method         String
  url            String
  payload        Json?
  state          CallbackState     @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(6)
  nextAttemptAt  DateTime          @default(now())
  lastHttpStatus Int?
  lastError      String?
  /// Last attempts: [{at, httpStatus, error, ms}] (most recent 10).
  log            Json              @default("[]")
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([state, nextAttemptAt])
  @@index([tenantId, vendorId, createdAt])
}

/// Tenant-specific AI permissions and limits (absent row = server defaults).
model TenantAiPolicy {
  tenantId              String   @id
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  enabled               Boolean  @default(true)
  /// AI tasks this tenant may use, e.g. ["architect","translate"].
  allowedTasks          String[] @default(["architect", "translate"])
  requestsPerMinute     Int      @default(10)
  requestsPerDay        Int      @default(500)
  /// Monthly spend cap in micro-USD (0 = no cap).
  monthlyBudgetMicroUsd BigInt   @default(0)
  /// Redact e-mail addresses, phone and card numbers from briefs and documents before sending.
  redactPii             Boolean  @default(true)
  updatedById           String?
  updatedAt             DateTime @updatedAt
}

/// One AI call: who, what task, which provider and model, tokens, cost and outcome.
model AiUsage {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String?
  task             String
  provider         String
  model            String
  /// ok, error, refused, rate_limited, budget_exceeded, circuit_open, not_permitted.
  outcome          String
  errorCode        String?
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMicroUsd     BigInt   @default(0)
  latencyMs        Int      @default(0)
  /// Survey the call was about, if any.
  surveyId         String?
  /// Number of values redacted from the input.
  redactions       Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, task, createdAt])
}

/// Fingerprint of a long open answer (normalized text, SHA-256), to spot the same text from different respondents.
model OpenEndFingerprint {
  id         String   @id @default(cuid())
  surveyId   String
  questionId String
  hash       String
  responseId String
  createdAt  DateTime @default(now())

  @@unique([responseId, questionId])
  @@index([surveyId, questionId, hash])
}

/// A survey an interviewer may conduct in the CAPI app.
model CapiAssignment {
  id            String   @id @default(cuid())
  tenantId      String
  surveyId      String
  survey        Survey   @relation(fields: [surveyId], references: [id])
  interviewerId String
  interviewer   User     @relation(fields: [interviewerId], references: [id])
  /// Optional number of completes expected from this interviewer (shown in the app; not enforced).
  target        Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([surveyId, interviewerId])
  @@index([tenantId, interviewerId])
}

/// One person to call for a CATI survey (Milestone 9). The phone number is sealed with SecretBox.
model CatiCase {
  id              String         @id @default(cuid())
  tenantId        String
  surveyId        String
  survey          Survey         @relation(fields: [surveyId], references: [id])
  /// Respondent id from the sample; becomes the interview's UID.
  code            String
  phoneSealed     String
  /// Last digits, for display without unsealing.
  phoneHint       String
  name            String?
  /// Extra sample columns, available to the survey as entry parameters.
  data            Json           @default("{}")
  status          CatiCaseStatus @default(PENDING)
  attempts        Int            @default(0)
  maxAttempts     Int            @default(6)
  nextCallAt      DateTime       @default(now())
  /// Who has the case open, until when (a lease, so an abandoned screen frees the case).
  lockedById      String?
  lockedUntil     DateTime?
  lastDisposition String?
  closedReason    String?
  responseId      String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  calls           CatiCall[]
  /// Milestone 18: the respondent's time zone (IANA, from the sample), else the survey's.
  timeZone        String?
  /// Keyed hash of the number, matched against the do-not-call list. Null on cases from before M18.
  phoneHash       String?

  @@unique([surveyId, code])
  @@index([surveyId, status, nextCallAt])
  @@index([tenantId, surveyId])
  @@index([tenantId, phoneHash])
}

/// Milestone 18: when a survey's cases may be called, in the respondent's local time.
model CatiSettings {
  surveyId  String   @id
  tenantId  String
  /// Used for cases without their own time zone.
  timeZone  String   @default("UTC")
  /// Minutes after local midnight: calls from callFrom up to (not including) callUntil.
  callFrom  Int      @default(540)
  callUntil Int      @default(1260)
  /// ISO weekdays allowed: 1 = Monday ... 7 = Sunday.
  days      Int[]    @default([1, 2, 3, 4, 5, 6])
  updatedAt DateTime @updatedAt
}

/// Milestone 18: numbers the organization must not call, as keyed hashes (never the number).
model DoNotCall {
  id          String   @id @default(cuid())
  tenantId    String
  phoneHash   String
  /// Last three digits, so an administrator can tell entries apart.
  hint        String
  /// respondent (asked on a call) | upload | manual
  source      String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, phoneHash])
}

/// One call attempt on a case, with its disposition.
/// Milestone 19: a survey's phone dialer settings. No row: interviewers dial by hand.
model CatiDialer {
  surveyId        String   @id
  tenantId        String
  enabled         Boolean  @default(false)
  /// Record calls (both sides) and keep the recording with the interview.
  recordCalls     Boolean  @default(false)
  /// Read to the respondent before the call is connected when calls are recorded.
  recordingNotice String?
  updatedAt       DateTime @updatedAt
}

/// Milestone 19: one call placed by the dialer. The interviewer's phone rings first; the respondent
/// is dialled when the interviewer answers. The id is random and appears in the provider's webhooks.
model CatiDial {
  id               String    @id
  tenantId         String
  surveyId         String
  caseId           String
  interviewerId    String
  provider         String
  /// The provider's id of the interviewer's call (Twilio CallSid).
  providerCallId   String?   @unique
  /// The interviewer's leg: queued | ringing | in-progress | completed | busy | no-answer | failed | canceled
  status           String    @default("queued")
  /// The respondent's leg, once dialled: answered | completed | busy | no-answer | failed | canceled
  respondentStatus String?
  /// Seconds the respondent was connected.
  talkSeconds      Int?
  record           Boolean   @default(false)
  /// none | pending | stored | discarded | failed
  recordingStatus  String    @default("none")
  recordingSid     String?
  recordingTries   Int       @default(0)
  captureId        String?
  error            String?
  createdAt        DateTime  @default(now())
  endedAt          DateTime?

  @@index([caseId, createdAt])
  @@index([recordingStatus])
}

model CatiCall {
  id            String    @id @default(cuid())
  tenantId      String
  caseId        String
  case          CatiCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  interviewerId String
  disposition   String
  note          String?
  callbackAt    DateTime?
  startedAt     DateTime
  endedAt       DateTime  @default(now())

  @@index([caseId])
  @@index([tenantId, interviewerId, endedAt])
}

/// Organization API key (Milestone 6). Acts as the member who created it, with at most the key's
/// role. Only a SHA-256 hash of the secret is stored; the full key is shown once.
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  name        String
  /// Public part of the key ("zapx_<prefix>_<secret>"), used to look it up.
  prefix      String    @unique
  secretHash  String
  /// PROGRAMMER or VIEWER. The effective role is the lower of this and the creator's role.
  role        Role
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
}

/// Outbound webhook subscription (Milestone 6). Payloads are signed and never carry answers.
model Webhook {
  id          String            @id @default(cuid())
  tenantId    String
  url         String
  description String?
  /// Event types, e.g. ["response.finished", "survey.published"].
  events      String[]
  /// Signing secret sealed with SecretBox (it must be readable to sign).
  secretEnc   String
  active      Boolean           @default(true)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveries  WebhookDelivery[]

  @@index([tenantId])
}

/// Outbox row for one webhook event: delivered by the background worker with retries.
model WebhookDelivery {
  id             String        @id @default(cuid())
  tenantId       String
  webhookId      String
  webhook        Webhook       @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  /// The exact JSON body that is signed and sent.
  payload        Json
  state          CallbackState @default(PENDING)
  attempts       Int           @default(0)
  maxAttempts    Int           @default(6)
  nextAttemptAt  DateTime      @default(now())
  lastHttpStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([state, nextAttemptAt])
  @@index([webhookId, createdAt])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Background job (Milestone 7): exports, QA runs, AI drafts. Run by the job worker, which claims
/// rows with FOR UPDATE SKIP LOCKED and a lease, so several workers can run safely.
model Job {
  id              String       @id @default(cuid())
  tenantId        String
  /// export | qa_run | ai_propose
  type            String
  surveyId        String?
  status          JobStatus    @default(QUEUED)
  input           Json
  result          Json?
  error           String?
  /// 0-100, and a short description of the current step.
  progress        Int          @default(0)
  progressNote    String?
  attempts        Int          @default(0)
  maxAttempts     Int          @default(2)
  runAfter        DateTime     @default(now())
  /// Lease: a running job whose lease expired (worker crashed) is picked up again.
  lockedUntil     DateTime?
  cancelRequested Boolean      @default(false)
  /// The member the job runs as; their current role and project access are checked when it runs.
  createdById     String
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  files           StoredFile[]

  @@index([status, runAfter])
  @@index([tenantId, surveyId, createdAt])
  @@index([finishedAt])
}

/// A file kept in the file store (Milestone 7): export results and uploaded documents for AI jobs.
/// The bytes live in the FileStore (local disk or object storage), never in the database.
model StoredFile {
  id          String    @id @default(cuid())
  tenantId    String
  surveyId    String?
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// export | upload
  purpose     String
  name        String
  contentType String
  size        Int
  sha256      String
  storageKey  String    @unique
  expiresAt   DateTime
  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([expiresAt, deletedAt])
  @@index([tenantId, createdAt])
}

/// A saved analysis (Milestone 10): filters plus frequencies or a crosstab definition.
model Report {
  id          String   @id @default(cuid())
  tenantId    String
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id])
  name        String
  /// {type: "crosstab" | "frequencies", filters, banner?, stubs?, variables?, confidence?}
  config      Json
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, surveyId])
}

/// An image, video or audio file shown in a survey (Milestone 11). Referenced from definitions by id,
/// served publicly to respondents. Kept while any version uses it; never expires.
model MediaAsset {
  /// 22-character random id (not a cuid): it is the public URL, so it must not be guessable.
  id          String    @id
  tenantId    String
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id])
  /// image | video | audio
  kind        String
  name        String
  contentType String
  size        Int
  sha256      String
  storageKey  String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([tenantId, surveyId])
}

/// A photo answer or an interview recording (Milestone 12). Private: only people who can see the
/// survey can open it, and every view is audited. Files live in the file store.
model Capture {
  /// 22-character random id.
  id                 String    @id
  tenantId           String
  surveyId           String
  responseId         String?
  response           Response? @relation(fields: [responseId], references: [id])
  /// CAPI: the interview's device-generated id. Captures are uploaded before the interview syncs.
  clientId           String?
  /// The value stored in the photo answer, or "audio" for the interview recording.
  ref                String
  /// photo | audio
  kind               String
  contentType        String
  size               Int
  sha256             String
  storageKey         String    @unique
  uploadedById       String?
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?
  /// Milestone 17: speech-to-text of a recording, when a reviewer asked for it. Deleted with the file.
  transcript         String?
  transcriptLanguage String?
  transcriptProvider String?
  transcribedAt      DateTime?

  @@unique([clientId, ref])
  @@unique([responseId, ref])
  @@index([tenantId, surveyId])
}

/// A device or network an organization blocked after rejecting fraud (Milestone 12). Only keyed hashes.
model FraudBlock {
  id          String   @id @default(cuid())
  tenantId    String
  /// device | network
  kind        String
  hash        String
  /// The rejected response it came from, and why.
  responseId  String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, kind, hash])
}

/// Milestone 20: a session that was signed out before it expired. Rows are removed once the session
/// would have expired anyway.
model RevokedSession {
  jti       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One-time password reset link. Created by an administrator (createdById set) or by "forgot
/// password" (createdById null, emailed only). Only a SHA-256 hash of the token is stored; a link
/// works once, until expiresAt, and creating a new one for the member voids the older ones.
model PasswordReset {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

enum LibraryItemKind {
  QUESTION
  SURVEY
  /// Blueprint phase 4: one or more pages of questions, inserted together.
  BLOCK
}

/// Blueprint phase 1: the organization's question bank. A QUESTION item holds one question (without
/// its page); a SURVEY item holds a whole definition used as an organization template.
model LibraryItem {
  id          String          @id @default(cuid())
  tenantId    String
  kind        LibraryItemKind
  name        String
  category    String          @default("General")
  tags        String[]        @default([])
  content     Json
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, kind])
}

/// Blueprint phase 2: the organization's translation glossary. Terms are sent with AI translation
/// requests and checked by per-language QA.
model GlossaryTerm {
  id          String   @id @default(cuid())
  tenantId    String
  /// Target language tag, e.g. "fr" or "es-MX".
  language    String
  source      String
  target      String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, language, source])
}

/// Blueprint phase 2: how often each page of a least-fill block has been picked for a respondent.
model BlockExposure {
  surveyId String
  blockId  String
  pageId   String
  count    Int    @default(0)

  @@id([surveyId, blockId, pageId])
}

/// Blueprint phase 2: saved QA test cases of a survey (answers plus expectations), run against
/// every draft as a regression suite.
model QaTestCase {
  id          String   @id @default(cuid())
  tenantId    String
  surveyId    String
  name        String
  /// The case as `qaTestCaseSchema` (answers, seed, expect).
  data        Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([surveyId])
}

// ---- Blueprint phase 3: fieldwork and security ------------------------------------------------

enum BackCheckMethod {
  PHONE
  VISIT
  RECORDING
}

enum BackCheckState {
  PENDING
  VERIFIED
  FAILED
  UNREACHABLE
}

/// A completed CAPI interview drawn for verification: a supervisor calls or visits the respondent,
/// or listens to the recording, and records whether the interview really took place as recorded.
model BackCheck {
  id            String          @id @default(cuid())
  tenantId      String
  surveyId      String
  responseId    String          @unique
  /// The interviewer of the checked interview (kept here so per-interviewer rates need no join).
  interviewerId String?
  method        BackCheckMethod @default(PHONE)
  state         BackCheckState  @default(PENDING)
  /// Questions re-asked during the check whose answer did not match.
  mismatches    String[]        @default([])
  note          String?
  sampledById   String
  checkedById   String?
  checkedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([surveyId, state])
  @@index([surveyId, interviewerId])
}

enum AppealState {
  OPEN
  UPHELD
  OVERTURNED
}

/// An interviewer asks for a quality decision on one of their interviews to be looked at again.
model QualityAppeal {
  id           String      @id @default(cuid())
  tenantId     String
  surveyId     String
  /// One appeal per interview.
  responseId   String      @unique
  raisedById   String
  message      String
  state        AppealState @default(OPEN)
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([surveyId, state])
  @@index([raisedById])
}

/// Someone a survey can be sent to by email (blueprint distribution).
model Contact {
  id             String    @id @default(cuid())
  tenantId       String
  surveyId       String
  /// Email or phone (or both); blueprint phase 5 adds phone for SMS invitations.
  email          String?
  /// E.164, e.g. +447700900123.
  phone          String?
  name           String?
  language       String?
  /// Extra columns from the import, passed to the survey as link parameters (e.g. region, panel id).
  fields         Json      @default("{}")
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([surveyId, email])
  @@unique([surveyId, phone])
  @@index([tenantId])
}

enum DistributionState {
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

/// One email invitation wave: who, when, the message, and reminders to people who have not finished.
enum DistributionChannel {
  EMAIL
  SMS
}

model Distribution {
  id              String              @id @default(cuid())
  tenantId        String
  surveyId        String
  name            String
  /// Blueprint phase 5: email (subject + body) or SMS (body only).
  channel         DistributionChannel @default(EMAIL)
  subject         String
  /// Plain text; [link] becomes the person's own survey link, [name] their name, [unsubscribe] the opt-out link.
  body            String
  sendAt          DateTime
  /// Remind people who have not completed this many days after the last email (0 = no reminders).
  reminderDays    Int                 @default(0)
  maxReminders    Int                 @default(0)
  reminderSubject String?
  state           DistributionState   @default(SCHEDULED)
  createdById     String
  sentAt          DateTime?
  createdAt       DateTime            @default(now())
  invitations     Invitation[]

  @@index([surveyId])
  @@index([state, sendAt])
}

enum InvitationState {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model Invitation {
  id             String          @id @default(cuid())
  tenantId       String
  distributionId String
  distribution   Distribution    @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  contactId      String
  /// The respondent id in the person's survey link; random, so links cannot be guessed.
  uid            String          @unique
  state          InvitationState @default(QUEUED)
  /// Emails sent: the invitation plus reminders.
  sends          Int             @default(0)
  lastSentAt     DateTime?
  nextReminderAt DateTime?
  error          String?
  createdAt      DateTime        @default(now())

  @@unique([distributionId, contactId])
  @@index([nextReminderAt])
}

// ---- Blueprint phase 5: automation, notifications, retention -------------------------------------

/// An automation rule: when the trigger happens (a survey event or a schedule) and every condition
/// holds, run the actions, or hold them for an administrator's approval first.
model AutomationRule {
  id               String          @id @default(cuid())
  tenantId         String
  name             String
  enabled          Boolean         @default(true)
  /// Only events of this survey (required for schedules). Null: every survey in the organization.
  surveyId         String?
  /// A webhook event name (response.finished, quota.full, ...) or "schedule".
  trigger          String
  /// For schedules: {every: "hour" | "day" | "week", at?: "HH:MM" (UTC), weekday?: 0-6}.
  schedule         Json?
  /// [{field, op, value}], all must hold. Fields: event.<key> or metrics.<name>.
  conditions       Json            @default("[]")
  /// [{type: "notify" | "email" | "webhook" | "set_survey_status", ...}]
  actions          Json
  requiresApproval Boolean         @default(false)
  /// The rule fires at most once in this many minutes (0: every time).
  cooldownMinutes  Int             @default(0)
  nextRunAt        DateTime?
  lastFiredAt      DateTime?
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  runs             AutomationRun[]

  @@index([tenantId, trigger])
  @@index([nextRunAt])
}

enum AutomationRunState {
  PENDING
  AWAITING_APPROVAL
  RUNNING
  DONE
  SKIPPED
  REJECTED
  FAILED
}

/// One firing of a rule: the event it saw, whether its conditions held, and what each action did.
model AutomationRun {
  id          String             @id @default(cuid())
  tenantId    String
  ruleId      String
  rule        AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  event       String
  data        Json
  state       AutomationRunState @default(PENDING)
  /// Why it was skipped, or the condition values seen.
  note        String?
  /// [{type, ok, detail}] per action.
  results     Json?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([state, createdAt])
  @@index([ruleId, createdAt])
  @@index([tenantId, state])
}

/// An in-app notification for one member.
model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  body      String
  /// A studio path to open, e.g. /surveys/abc?tab=automation.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Super admin: a subscription plan. Its features are listed separately for the web CRM and the
/// mobile app; its limits have the shape of PlanLimits (apps/api/src/plans/plans.ts).
model SubscriptionPlan {
  code           String   @id
  name           String
  description    String   @default("")
  /// Price per interval in the smallest currency unit (display only; Stripe prices are separate).
  priceCents     Int      @default(0)
  currency       String   @default("USD")
  interval       String   @default("month")
  limits         Json     @default("{}")
  webFeatures    String[] @default([])
  mobileFeatures String[] @default([])
  /// Offered when a super admin registers a new organization.
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Super admin automation: when a trigger matches an organization, run the actions.
model PlatformAutomation {
  id          String                  @id @default(cuid())
  name        String
  enabled     Boolean                 @default(true)
  /// org_created, subscription_ending, subscription_ended, completes_used, seats_full, admins_inactive.
  trigger     String
  /// Trigger settings, e.g. {days: 7} or {percent: 90}.
  params      Json                    @default("{}")
  /// [{type, ...settings}], run in order.
  actions     Json                    @default("[]")
  createdById String?
  lastRunAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  runs        PlatformAutomationRun[]
}

/// One firing of a platform automation for one organization. dedupeKey makes each firing happen once.
model PlatformAutomationRun {
  id           String             @id @default(cuid())
  automationId String
  automation   PlatformAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  tenantId     String
  dedupeKey    String
  /// ok, partial or failed.
  outcome      String
  results      Json               @default("[]")
  createdAt    DateTime           @default(now())

  @@unique([automationId, dedupeKey])
  @@index([createdAt])
}

/// Rate-limit counters shared by every API process (security review S4, THROTTLE_STORE=database).
model RateLimitBucket {
  /// "<throttler>:<client and route>", as built by the throttler guard.
  key          String    @id
  hits         Int
  windowEnds   DateTime
  blockedUntil DateTime?

  @@index([windowEnds])
}

/// An audience request with SAMPLEON for a SampCode survey. SampCode never selects or invites respondents:
/// SAMPLEON owns targeting, feasibility, approval, invitations, quotas and routing, and SUPPLY360
/// owns the respondents. SampCode keeps this row so the studio can show progress, updated from
/// SAMPLEON's signed events. `sourcePlatform` is "ZAPX" (the SAMPLEON wire value) for independent surveys (SampCode created the
/// request) and PROJEXA when PROJEXA created it for a PROJEXA-linked survey.
model SampleonAudienceRequest {
  id                String    @id @default(cuid())
  tenantId          String
  surveyId          String
  /// SAMPLEON's Audience Request ID (AR-…), the correlation id of every event.
  audienceRequestId String    @unique
  sourcePlatform    String
  status            String
  title             String?
  countries         String[]  @default([])
  requiredCompletes Int
  completes         Int       @default(0)
  remaining         Int?
  /// Latest project.quota_updated payload: progress, byCountry, quotas.
  progress          Json      @default("{}")
  /// project.quota_updated sequence; older snapshots arriving late are ignored.
  progressSequence  Int       @default(0)
  lastEventType     String?
  lastEventAt       DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, surveyId])
}

/// SAMPLEON events already processed (deduplicated by event id).
model SampleonInboundEvent {
  eventId           String   @id
  type              String
  audienceRequestId String?
  receivedAt        DateTime @default(now())
}
