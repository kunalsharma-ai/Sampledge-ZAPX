{
  "name": "@zapx/survey-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zapx/logic-engine": "workspace:*",
    "@zapx/survey-schema": "workspace:*"
  },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": {
    "@types/react": "19.1.8",
    "react": "19.1.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3"
  }
}
