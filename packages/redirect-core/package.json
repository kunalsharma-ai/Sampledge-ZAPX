{
  "name": "@zapx/redirect-core",
  "version": "0.1.0",
  "private": true,
  "description": "Redirect & Vendor Integration core: statuses, precedence, signing, retry policy and partner adapters. No framework or database dependencies, so it can move into its own service.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "@types/node": "22.15.30"
  }
}
