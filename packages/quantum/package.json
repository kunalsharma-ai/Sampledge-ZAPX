{
  "name": "@zapx/quantum",
  "version": "0.1.0",
  "private": true,
  "description": "ZAPX Quantum Design System: theme presets, design tokens and the theme engine that turns a person's appearance settings into CSS custom properties with checked contrast. No framework dependencies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "@types/node": "26.6.5"
  }
}
