{
  "name": "zapx",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @zapx/db migrate:deploy",
    "db:seed": "pnpm --filter @zapx/db seed",
    "e2e": "pnpm --filter @zapx/e2e e2e",
    "format": "prettier --write .",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "prettier": "3.5.3",
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1"
  }
}
