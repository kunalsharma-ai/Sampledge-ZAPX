# Integrations (Claude, IPinfo, Deepgram, Twilio, Stripe, S3) are easiest to set in the CRM:
# Settings > Integrations. Values saved there win over the variables below, which stay as a fallback.

# ---- Database ------------------------------------------------------------------------------
# Prisma pool: add ?connection_limit=10&pool_timeout=20 per API instance (see docs/operations/database.md).
DATABASE_URL=postgresql://zapx:zapx@localhost:5432/zapx

# ---- Security ------------------------------------------------------------------------------
# At least 32 random characters in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Encrypts partner secrets at rest. Required in production; falls back to JWT_SECRET in development.
SECRETS_KEY=
# Derives the keys for test links, duplicate-check hashes and SSO state, so rotating JWT_SECRET only
# signs people out. Required in production (its own random value); falls back to JWT_SECRET in development.
SIGNING_KEYS_SECRET=
# Set to true when served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Allow self-service sign-up (creates a new tenant). Disable in production.
ALLOW_SIGNUP=true
# Plan for organizations created by sign-up: free, team, business or enterprise (unlimited).
DEFAULT_PLAN=enterprise
# Public address of the studio. SSO redirect URI is ${STUDIO_URL}/api/auth/sso/callback.
STUDIO_URL=http://localhost:3000
# Development and tests only: allow http and private-network identity providers.
SSO_ALLOW_INSECURE_ISSUER=false
# Sign-ups allowed per minute from one address (default 5).
# SIGNUP_RATE_PER_MINUTE=5
# Sign-in attempts per minute from one address (default 10).
# LOGIN_RATE_PER_MINUTE=10
# Wrong passwords in a row before an account is locked, and for how many minutes (defaults 10 and 15).
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCK_MINUTES=15
# Hours a password reset link works (administrator link, or "forgot password" email when EMAIL_PROVIDER is set).
# PASSWORD_RESET_HOURS=24
# Rate-limit counters: database (shared by every API process) or memory (per process).
# Default: database when NODE_ENV=production, memory otherwise.
# THROTTLE_STORE=memory
# In production (NODE_ENV=production) the API refuses to start unless COOKIE_SECURE=true and
# JWT_SECRET, SECRETS_KEY and SIGNING_KEYS_SECRET are your own random values (not the examples above, not equal).

# ---- Web -----------------------------------------------------------------------------------
API_PORT=4000
# Public base URL of the respondent runtime, used to build survey links.
RUNTIME_BASE_URL=http://localhost:5173
# Offline interviewer (CAPI) app, shown to programmers when they assign interviewers
CAPI_APP_URL=http://localhost:5174
UPLOAD_MAX_MB=15
# Largest survey media upload (video), in MB. Images are capped at 10 MB and audio at 25 MB.
MEDIA_MAX_MB=100
# Fraud checks: header your edge network sets with the respondent's country (e.g. cloudfront-viewer-country).
# Leave empty unless respondents can only reach the API through that edge.
GEO_COUNTRY_HEADER=
# VPN, proxy, Tor and data-centre checks (Milestone 16): off, or ipinfo with an IPinfo token whose plan
# includes privacy detection. Each respondent's address is sent to IPinfo when an interview starts.
NETWORK_REPUTATION=off
IPINFO_TOKEN=
# Transcripts of interview recordings (Milestone 17): off, or deepgram with a key and the model to use.
# A recording is sent to Deepgram only when a reviewer asks for its transcript.
TRANSCRIPTION=off
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
# Phone dialer for CATI (Milestone 19): off, or twilio. The interviewer's phone rings first and the
# respondent is dialled from TWILIO_CALLER_ID. TELEPHONY_WEBHOOK_BASE is the public address of this
# API, ending in /api, that Twilio calls back (signed with the auth token).
TELEPHONY=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TELEPHONY_WEBHOOK_BASE=
# CAPI recordings: largest upload in MB, and days to keep photos and recordings (0 = until erased)
CAPTURE_MAX_MB=100
CAPTURE_RETENTION_DAYS=0

# ---- AI gateway (optional; AI features stay off until a key and a model are set) -----------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default model for every AI task; AI_MODEL_ARCHITECT / AI_MODEL_TRANSLATE override per task.
AI_MODEL=claude-opus-5-5
AI_MODEL_ARCHITECT=
AI_MODEL_TRANSLATE=
# USD per million tokens, used for cost tracking. Check current provider pricing.
AI_PRICING='{"claude-opus-5-5":{"input":4,"output":20,"cacheRead":0.2,"cacheWrite":5}}'
AI_MAX_RETRIES=2
AI_BREAKER_FAILURES=5
AI_BREAKER_OPEN_MS=60000
# Defaults for organizations without their own AI settings.
AI_DEFAULT_RPM=10
AI_DEFAULT_RPD=500

# ---- Background jobs and files (Milestone 7) ------------------------------------------------
# Run jobs inside the API. Set to off (and CALLBACK_WORKER=off) when `node dist/worker.js` runs them.
JOB_WORKER=on
# Super admin automation rules (subscription ends, usage alerts, ...): checked every PLATFORM_AUTOMATION_MS.
PLATFORM_AUTOMATION=on
PLATFORM_AUTOMATION_MS=60000
JOB_POLL_MS=2000
# Where file bytes live: local (FILES_DIR, shared by the API and the worker) or s3 (Milestone 13).
FILE_STORE=local
FILES_DIR=.data/files
# FILE_STORE=s3: a private bucket. Credentials come from the AWS chain (the ECS task role on AWS).
S3_BUCKET=
S3_REGION=eu-west-1
S3_PREFIX=
# KMS key for SSE-KMS; empty uses SSE-S3 (AES-256).
S3_KMS_KEY_ID=
# Only for S3-compatible test services (MinIO, LocalStack).
S3_ENDPOINT=
# Direct exports above this many rows must run in the background.
EXPORT_SYNC_MAX_ROWS=10000
EXPORT_FILE_TTL_HOURS=72
JOB_RETENTION_DAYS=30
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# ---- Redirects and callbacks ---------------------------------------------------------------
CALLBACK_WORKER=on
CALLBACK_POLL_MS=5000
CALLBACK_TIMEOUT_MS=10000
# Only for local development and tests: lets callbacks reach localhost and private networks.
CALLBACK_ALLOW_PRIVATE_HOSTS=false
# Unfinished interviews with no activity for this long are recorded as partial.
ABANDON_AFTER_MINUTES=1440

# ---- SAMPLEON (Sampledge audience and routing engine; docs/modules/sampleon.md) -------------
# Unset SAMPLEON_URL to leave the integration off.
SAMPLEON_URL=
# ZAPX's client id and secret at SAMPLEON: sign ZAPX's requests and verify SAMPLEON's webhooks.
SAMPLEON_CLIENT_ID=zapx
SAMPLEON_CLIENT_SECRET=
# The survey-host outcome secret SAMPLEON holds for ZAPX (signs the S2S outcome confirmation).
SAMPLEON_OUTCOME_SECRET=

# ---- Database from parts (Milestone 13) ------------------------------------------------------
# Instead of DATABASE_URL, set DB_HOST, DB_USER, DB_PASSWORD (and DB_PORT, DB_NAME, DB_SSLMODE):
# this is how the RDS-managed password reaches the tasks on AWS. DATABASE_URL wins when both are set.

# ---- Proxies and the CDN (Milestone 13) ------------------------------------------------------
# Proxies in front of the API that add X-Forwarded-For (1 behind one load balancer).
TRUST_PROXY_HOPS=1
# Shared secret the CDN sends as X-Zapx-Edge. When set, the viewer address header and
# GEO_COUNTRY_HEADER are believed only on requests carrying it (32+ characters).
EDGE_SHARED_SECRET=
# e.g. cloudfront-viewer-address
EDGE_CLIENT_ADDRESS_HEADER=

# ---- Billing (Milestone 13) ------------------------------------------------------------------
# off, or stripe: admins buy plans with Stripe Checkout; Stripe webhooks set the plan.
BILLING=off
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint ${STUDIO_URL}/api/billing/webhook in Stripe.
STRIPE_WEBHOOK_SECRET=
# Plan code to Stripe price ID, e.g. {"team":"price_...","business":"price_..."}
STRIPE_PRICES=
# Pin the Stripe API version; empty uses the account default.
STRIPE_API_VERSION=
# Plan an organization falls back to when its subscription ends.
BILLING_FALLBACK_PLAN=free

# Blueprint phase 3: email invitations and reminders. off sends nothing; sendgrid sends through
# SendGrid's v3 Mail Send API (needs SENDGRID_API_KEY and a verified EMAIL_FROM sender).
EMAIL_PROVIDER=off
# SENDGRID_API_KEY=
# EMAIL_FROM=surveys@example.com
# EMAIL_FROM_NAME=ZAPX surveys
