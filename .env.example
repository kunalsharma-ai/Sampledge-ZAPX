# ---- Database ------------------------------------------------------------------------------
# Prisma pool: add ?connection_limit=10&pool_timeout=20 per API instance (see docs/operations/database.md).
DATABASE_URL=postgresql://zapx:zapx@localhost:5432/zapx

# ---- Security ------------------------------------------------------------------------------
# At least 32 random characters in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Encrypts partner secrets at rest. Required in production; falls back to JWT_SECRET in development.
SECRETS_KEY=
# Set to true when served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Allow self-service sign-up (creates a new tenant). Disable in production.
ALLOW_SIGNUP=true

# ---- Web -----------------------------------------------------------------------------------
API_PORT=4000
# Public base URL of the respondent runtime, used to build survey links.
RUNTIME_BASE_URL=http://localhost:5173
UPLOAD_MAX_MB=15

# ---- AI gateway (optional; AI features stay off until a key and a model are set) -----------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default model for every AI task; AI_MODEL_ARCHITECT / AI_MODEL_TRANSLATE override per task.
AI_MODEL=claude-opus-5-5
AI_MODEL_ARCHITECT=
AI_MODEL_TRANSLATE=
# USD per million tokens, used for cost tracking. Check current provider pricing.
AI_PRICING='{"claude-opus-5-5":{"input":4,"output":20,"cacheRead":0.2,"cacheWrite":5}}'
AI_MAX_RETRIES=2
AI_BREAKER_FAILURES=5
AI_BREAKER_OPEN_MS=60000
# Defaults for organizations without their own AI settings.
AI_DEFAULT_RPM=10
AI_DEFAULT_RPD=500

# ---- Redirects and callbacks ---------------------------------------------------------------
CALLBACK_WORKER=on
CALLBACK_POLL_MS=5000
CALLBACK_TIMEOUT_MS=10000
# Only for local development and tests: lets callbacks reach localhost and private networks.
CALLBACK_ALLOW_PRIVATE_HOSTS=false
# Unfinished interviews with no activity for this long are recorded as partial.
ABANDON_AFTER_MINUTES=1440

# ---- Observability -------------------------------------------------------------------------
# Tracing starts only when an OTLP endpoint is set (e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=zapx-api
