    "zod": "3.25.67",
    "@zapx/redirect-core": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.3",
    "@swc/core": "1.12.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "8.0.0",
    "supertest": "7.1.1",
    "typescript": "5.8.3",
    "unplugin-swc": "1.5.5",
    "vitest": "3.2.4"
