{
  "name": "@zapx/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && dotenv -e ../../.env -- node dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@nestjs/common": "11.1.3",
    "@nestjs/core": "11.1.3",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.3",
    "@nestjs/throttler": "6.4.0",
    "@zapx/db": "workspace:*",
    "@zapx/logic-engine": "workspace:*",
    "@zapx/survey-schema": "workspace:*",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "mammoth": "1.13.0",
    "multer": "2.0.2",
    "reflect-metadata": "0.2.2",
