{
  "expo": {
    "name": "ZAPX",
    "slug": "zapx",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "zapx",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#090620",
    "ios": {
      "bundleIdentifier": "com.sampledge.zapx",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSCameraUsageDescription": "ZAPX uses the camera for photo questions and face-to-face interview evidence, only when a survey asks for it.",
        "NSMicrophoneUsageDescription": "ZAPX records audio in face-to-face interviews only when the respondent consents.",
        "NSLocationWhenInUseUsageDescription": "ZAPX records where face-to-face interviews take place, when the survey requires it."
      }
    },
    "android": {
      "package": "com.sampledge.zapx",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#090620",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090620",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "zapxServer": ""
    }
  }
}
