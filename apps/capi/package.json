{
  "name": "@zapx/capi",
  "version": "0.1.0",
  "private": true,
  "description": "Offline interviewer app (CAPI): downloads assigned surveys, runs interviews with the shared logic engine without a connection, and syncs them to the API.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zapx/logic-engine": "workspace:*",
    "@zapx/survey-renderer": "workspace:*",
    "@zapx/survey-schema": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
